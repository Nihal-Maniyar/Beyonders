# LearnLoop AI Configuration Example
APP_ENV=development
LOG_LEVEL=INFO
DEMO_MODE=true

# Database: SQLite for local dev, PostgreSQL for production
DATABASE_URL=sqlite:///./learnloop.db

# Hosting & Server Ports
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Anonymous Session Security (change in production)
SESSION_TOKEN_PEPPER=learnloop-production-secret-pepper-replace-me
SESSION_EXPIRY_HOURS=24

# Optional LLM Provider (openai, anthropic, or gemini)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Optional ElevenLabs Voice Services
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_STT_MODEL_ID=scribe_v2
